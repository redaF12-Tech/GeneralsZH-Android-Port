<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- GeneralsX @feature Android port accent-colors 21/09/2026 The DARKMODE
         halves of the five alternate accent palettes offered by the launcher's
         Interface -> Accent picker (ThemeHelper). The default violet lives in
         the base values-night/colors.xml and needs no overlay. Names mirror
         values/accent_colors.xml exactly — keep the two lists in sync.

         Dark roles follow the M3 dark-scheme derivation the default violet
         palette already uses: primary is the P80 tone (light), on_primary the
         P10/P20 tone (dark), container the P30, on_container the P90. White
         would be unreadable on the light primaries in darkmode. -->

    <!-- Blue -->
    <color name="gzh_accent_blue_primary">#A8C8FF</color>
    <color name="gzh_accent_blue_on_primary">#00315C</color>
    <color name="gzh_accent_blue_container">#1E4787</color>
    <color name="gzh_accent_blue_on_container">#D3E4FF</color>
    <color name="gzh_accent_blue_ripple">#33A8C8FF</color>

